{
  "name": "unkillable-agent-workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Jahid Khan Tuhin",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev.mjs --stop",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build": "pnpm -r build",
    "prepare": "node scripts/prepare.mjs",
    "db:migrate": "pnpm --filter @unkillable/api migrate",
    "seed": "pnpm --filter @unkillable/api seed",
    "test:integration": "tsx --env-file=.env scripts/test-integration.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "latest",
    "eslint": "10.14.0",
    "husky": "latest",
    "lint-staged": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": "prettier --write"
  }
}

NODE_ENV=development
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/unkillable?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
# Generate a private value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-private-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
# Local seed only. Existing accounts retain their password; SEED_ROLE is applied on every seed run.
SEED_EMAIL=jahidkhantuhin@gmail.com
SEED_PASSWORD=111111111111
SEED_NAME=Jahid Khan Tuhin
SEED_ROLE=admin
# API and worker must use the same queue. Worker timings are conservative dev defaults.
RUN_QUEUE_NAME=workflow-runs
WORKER_LOCK_DURATION_MS=15000
WORKER_STALLED_INTERVAL_MS=5000
WORKER_MAX_STALLED_COUNT=3
DEMO_NODE_DELAY_MS=1500
# Optional per-node retry overrides; unspecified fields use defaults (3 attempts, 1s seed, 10s cap, 20% jitter).
NODE_RETRY_POLICIES={}
# Support and moderation workflows: mock is deterministic and requires no model key or quota.
SUPPORT_LLM_PROVIDER=gemini
# Set both only when explicitly opting into Gemini; model names are provider configuration.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional local Ollama via its OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
# Optional local policy adapter. See docs/STEP-6.md for its HTTP contract.
ORGMIND_RETRIEVER_ENABLED=false
ORGMIND_RETRIEVER_URL=http://127.0.0.1:8000/retrieve
# Only local Mailpit SMTP endpoints are accepted. No real customer email delivery.
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
# Used by integration tests to verify captured Mailpit messages.
MAILPIT_API_URL=http://127.0.0.1:8025

# Development chaos controls. Leave disabled for normal operation; see docs/STEP-9.md.
CHAOS_ENABLED=false
# Restart delay for the development-only API/worker supervisors (100–30000 ms).
CHAOS_RESTART_DELAY_MS=1000

# Step 14: optional approval channels. Web links work without Telegram.
# Public dashboard origin used by links; use HTTPS for production/mobile access.
WEB_PUBLIC_URL=http://localhost:3000
# Signed decisions use a domain-separated HMAC with BETTER_AUTH_SECRET (60–3600 seconds).
APPROVAL_LINK_TTL_SECONDS=900
TELEGRAM_ENABLED=false
# Configure your own private demo bot only; see docs/STEP-14.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Generate a private URL-safe value of at least 32 characters; never commit it.
TELEGRAM_WEBHOOK_SECRET=

# Optional WhatsApp Sandbox approvals alongside Telegram. See docs/WHATSAPP-LOCAL.md.
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Copy the actual WhatsApp sender from your Twilio console.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Exact public HTTPS callback, forwarded by the web app to the local API.
WHATSAPP_WEBHOOK_URL=

# Step 15: policies are snapshotted when an approval is requested; milliseconds.
APPROVAL_SLA_ENABLED=true
# Defaults: remind 30m, escalate to admins at 60m, reject at 24h.
# Example short demo: {"durability-demo":{"remindMs":30000,"escalateMs":60000,"expireMs":120000,"timeoutAction":"reject","escalateRole":"admin"}}
APPROVAL_SLA_POLICIES={}
# Optional OTLP/HTTP collector. Empty means persist local spans without exporting.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# USD per million tokens, keyed by provider:model. Empty means unknown price.
# Illustrative math only, not current provider prices: {"gemini:YOUR_MODEL":{"inputPerMillion":1,"outputPerMillion":2}}
LLM_PRICING_JSON={}

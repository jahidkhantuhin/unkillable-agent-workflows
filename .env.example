NODE_ENV=development
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/unkillable?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
# Generate a private value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-private-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
# Local seed only. Existing accounts retain their password; SEED_ROLE is applied on every seed run.
SEED_EMAIL=admin@example.test
SEED_PASSWORD=local-demo-password-change-me
SEED_NAME=Jahid Khan Tuhin
SEED_ROLE=admin
